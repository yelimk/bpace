# BPACE Backend Environment Variables Template

# Server Environment
PORT=3000
NODE_ENV=development

# Database Connection (Local SQLite for testing / Supabase PostgreSQL for Production)
# Local SQLite Example:
DATABASE_URL="file:./dev.db"

# Production Supabase PostgreSQL Example:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"

# Gemini 2.0 Flash AI API Key (Free Tier)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here
