# BPACE Backend Environment Variables Template (.env.example)
# Copy this file to .env and fill in your confidential secret keys

# Node Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (Prisma SQLite for Dev / PostgreSQL for Prod)
DATABASE_URL="file:./dev.db"

# JWT Authentication Secret Key
JWT_SECRET="bpace_jwt_secret_key_2026_change_in_production"

# Google AI Studio Gemini API Key (100% Free Tier)
# Get your free key at https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
