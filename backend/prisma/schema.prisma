// BPACE Database Schema Definition (Prisma ORM)
// Datasource supports local SQLite for development and PostgreSQL/Supabase for Production

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 1. User Model (회원 정보)
model User {
  id            String         @id @default(uuid())
  email         String?        @unique
  passwordHash  String?
  name          String
  authProvider  String         @default("email") // "email", "google", "guest"
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  measurements  Measurement[]
  breathingLogs BreathingLog[]
  schedules     Schedule[]
  aiReports     AiReport[]
}

// 2. Measurement Model (PPG 생체 측정 내역)
model Measurement {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  bpm            Int
  hrvRmssd       Float
  hrvSdnn        Float
  conditionScore Int
  signalQuality  String   @default("good") // "good", "poor"
  samplesCount   Int      @default(600)
  measuredAt     DateTime @default(now())
}

// 3. BreathingLog Model (호흡 세션 완료 기록)
model BreathingLog {
  id              String   @id @default(uuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  category        String   // "진정", "이완", "집중", "회복", "각성"
  routineName     String   // "생리학적 한숨", "4-7-8 호흡", "4-4-4-4 박스 호흡" 등
  durationSeconds Int
  completionRate  Float    @default(100.0)
  userNotes       String?
  completedAt     DateTime @default(now())
}

// 4. Schedule Model (일정 및 구글 캘린더 동기화)
model Schedule {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  startTime      DateTime
  endTime        DateTime
  syncedToGoogle Boolean  @default(false)
  createdAt      DateTime @default(now())
}

// 5. AiReport Model (Gemini AI 주간/실시간 보고서 저장)
model AiReport {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  weekStartDate  String   // "YYYY-MM-DD"
  headline       String
  avgBpmAnalysis String
  maxBpmAnalysis String
  minBpmAnalysis String
  overallGuide   String
  createdAt      DateTime @default(now())
}
